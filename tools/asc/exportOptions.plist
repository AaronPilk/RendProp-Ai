<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Export options for `xcodebuild -exportArchive`, used by
  tools/asc/bridge-600-archive-upload.sh.

  Key reference: run `xcodebuild -help` on the Mac and read the section
  "Available keys for -exportOptionsPlist". That built-in help is the only
  authoritative list Apple publishes for these keys; it cannot be read from a
  Linux container, so the values below were chosen from Apple's distribution
  documentation and must be sanity-checked against `xcodebuild -help` once, on
  the Mac, the first time this runs.

  method
      Xcode 15.3 renamed the App Store destination from "app-store" to
      "app-store-connect". Xcode 15.3+ accepts the new name; older Xcode needs
      "app-store". The bridge script picks the right one automatically by
      reading the Xcode version, so this file carries the modern spelling.

  destination
      "upload" makes -exportArchive send the build to App Store Connect instead
      of writing an .ipa to disk ("export", the default). Combined with the
      -authenticationKeyPath / -authenticationKeyID / -authenticationKeyIssuerID
      flags on the xcodebuild command line, the upload authenticates with the
      App Store Connect API key - no Apple ID password or app-specific password.

  signingStyle / teamID
      Automatic signing, resolved against the Rendprop team. xcodebuild is
      invoked with -allowProvisioningUpdates so it can create or refresh the
      distribution certificate and provisioning profile on demand.

  manageAppVersionAndBuildNumber
      true lets App Store Connect assign the build number, so a re-upload never
      fails with "the build number has already been used".

  uploadSymbols
      true ships the dSYMs, which is what makes TestFlight and Xcode Organizer
      crash reports symbolicated.
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>

	<key>destination</key>
	<string>upload</string>

	<key>signingStyle</key>
	<string>automatic</string>

	<key>teamID</key>
	<string>5F5C5G25Y6</string>

	<key>manageAppVersionAndBuildNumber</key>
	<true/>

	<key>uploadSymbols</key>
	<true/>

	<key>generateAppStoreInformation</key>
	<true/>

	<key>stripSwiftSymbols</key>
	<true/>
</dict>
</plist>
