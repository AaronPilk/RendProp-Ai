        try expect(AgentCard.current.name == nameOnly["name"] && PersonalCardStore.receipt(owner: owner) == disjointReceipt, "Hosted read begun before Save cannot overwrite acknowledged personal card")
        let nullBytes = try JSONEncoder().encode(empty)
        try expect(try JSONDecoder().decode(PersonalCardReceipt.self, from: nullBytes).publicCard == nil, "Explicit null never-saved receipt roundtrips without lost key presence")
        var explicitEmpty = disjointReceipt.publicCard!; explicitEmpty["website"] = ""
        let emptyBaseline = PersonalCardReceipt(ok: true, userID: owner, spaceType: disjointDraft.spaceType, publicCard: explicitEmpty)
        var unchangedEmptyFields = AgentCard.current.brandFields; unchangedEmptyFields["website"] = ""
        let emptyDraft = PersonalCardDraft(id: UUID(), owner: owner, spaceType: disjointDraft.spaceType, fields: unchangedEmptyFields, expected: emptyBaseline)
        try expect(emptyDraft.changedFields["website"] == nil, "Unedited explicit empty field is not submitted as a new deletion intent")
        var clearedFields = AgentCard.current.brandFields; clearedFields["phone"] = ""
        let clearDraft = PersonalCardDraft(id: UUID(), owner: owner, spaceType: disjointDraft.spaceType, fields: clearedFields, expected: disjointReceipt)
        try expect(clearDraft.changedFields == ["phone":""], "Explicitly cleared phone is the only changed contact field")
        var clearReceiptFields = disjointReceipt.publicCard!; clearReceiptFields.removeValue(forKey: "phone")
        live.response = try JSONEncoder().encode(PersonalCardReceipt(ok: true, userID: owner, spaceType: disjointDraft.spaceType, publicCard: clearReceiptFields))
        _ = try await live.savePersonalCard(clearDraft.changedFields, spaceType: clearDraft.spaceType, expected: clearDraft.expected)
        let clearWire = try JSONSerialization.jsonObject(with: live.requests.last!.httpBody!) as! [String:Any]
        try expect((clearWire["changes"] as! [String:Any])["phone"] is NSNull && ((clearWire["expected"] as! [String:[String:Any]])["phone"]?["value"] as? String) == newerPhone, "Actual clear wire removes phone against its exact present value")
        let beforeReload = AgentCard.current.brandFields
        UserDefaults.standard.set(Data("unreadable".utf8), forKey: PersonalCardStore.prefix(owner) + "pending")
        try await rejects("Unreadable personal pending record cannot be replaced automatically") { _ = try PersonalCardStore.stage(beforeReload, type: .realEstate, expected: disjointReceipt) }
        try expect(UserDefaults.standard.data(forKey: PersonalCardStore.prefix(owner) + "pending") == Data("unreadable".utf8), "Failed automatic save retains unreadable authoritative record")
        try PersonalCardStore.reload(disjointReceipt, owner: owner)
        try expect(try PersonalCardStore.pending(owner: owner) == nil && AgentCard.current.brandFields == beforeReload, "Explicit verified reload retires pending JSON while retaining own local contact")
        try await rejects("Old held personal acknowledgement cannot erase explicit reload") { try PersonalCardStore.acknowledge(disjointReceipt, draft: disjointDraft) }
        let eraseSuite = "profile.erase." + UUID().uuidString, eraseDefaults = UserDefaults(suiteName: eraseSuite)!
        defer { eraseDefaults.removePersistentDomain(forName: eraseSuite) }
        for key in ["personal.card.v1.account-a.receipt", "personal.card.v1.account-a.pending", "personal.card.v1.account-b.agent.name", "personal.card.v1.account-b.dirty.real_estate"] { eraseDefaults.set("private contact", forKey: key) }
        eraseDefaults.set("unrelated preference", forKey: "isolated.unrelated")
        PersonalCardStore.eraseDeviceCache(defaults: eraseDefaults)
        try expect(!eraseDefaults.dictionaryRepresentation().keys.contains(where: { $0.hasPrefix("personal.card.v1.") }), "Phone erase removes all account personal contact caches and drafts")
        try expect(eraseDefaults.string(forKey: "isolated.unrelated") == "unrelated preference", "Personal-cache erase leaves unrelated preference handling to existing device wipe")
        let beforeLogoRead = AgentCard.personalReadVersion, actualPrefix = WorkspaceContext.storagePrefix
        let sourceLogoDraft = try ProfileLogoStore.stage(image: Data([4,5,6]), owner: owner.uuidString, orgID: org, prefix: actualPrefix)
        let newLogoURL = "https://assets.fixture.invalid/new-acknowledged.png"
        try ProfileLogoStore.acknowledge(.init(ok: true, orgID: org, businessLogoURL: newLogoURL), draft: sourceLogoDraft, prefix: actualPrefix)
        AgentCard.acceptCloud(.init(userID: owner, orgID: org, spaceType: SpaceType.realEstate.rawValue, fields: [:]), personalReadVersion: beforeLogoRead)
        try expect(ProfileLogoStore.hostedURL(prefix: actualPrefix) == newLogoURL, "Hosted brand read begun before logo Save cannot erase acknowledged logo")
        let beforeExplicitReload = AgentCard.personalReadVersion
        let reloadDraft = try ProfileLogoStore.stage(image: Data([7,8,9]), owner: owner.uuidString, orgID: org, prefix: actualPrefix)
        let reloadPath = FileStore.documents.appendingPathComponent(reloadDraft.path!)
        let refreshedLogo = "https://assets.fixture.invalid/refreshed-logo.png"
        live.brand = .init(userID: owner, orgID: org, spaceType: SpaceType.realEstate.rawValue, fields: ["business_logo_url": refreshedLogo])
        let editor = ClosedLogoEditor(api: live)
        // Capture the read immediately before Reload, after any earlier draft
        // staging. This makes the control depend on the action's own fence.
        let heldLogoRead = AgentCard.personalReadVersion
        await editor.reloadLogo()
        try expect(editor.logoError == nil && editor.previews == 1 && !editor.savingLogo && ProfileLogoStore.hostedURL(prefix: actualPrefix) == refreshedLogo, "Actual explicit logo Reload adopts verified hosted pointer and completes")
        try expect(try ProfileLogoStore.pending(prefix: actualPrefix) == nil && FileManager.default.fileExists(atPath: reloadPath.path), "Explicit logo Reload retires only owned pending pointer and preserves source image")
        AgentCard.acceptCloud(.init(userID: owner, orgID: org, spaceType: SpaceType.realEstate.rawValue, fields: ["business_logo_url": newLogoURL]), personalReadVersion: heldLogoRead)
        try expect(ProfileLogoStore.hostedURL(prefix: actualPrefix) == refreshedLogo, "Hosted brand read begun before explicit logo Reload cannot replace refreshed logo")
        try expect(AgentCard.personalReadVersion > beforeExplicitReload, "Logo state transitions advance the account read generation")
        let lateReload = ClosedLogoEditor(api: live)
        live.onExecute = { AuthStore.shared.syncSessionRevision += 1 }
        // cloudBrand's closed async read invokes the same held-response hook.
        await lateReload.reloadLogo()
        try expect(lateReload.logoError != nil && lateReload.previews == 0 && ProfileLogoStore.hostedURL(prefix: actualPrefix) == refreshedLogo, "Actual explicit logo Reload rejects a late changed session without pointer mutation")
        live.onExecute = nil
        let ownerPrefix = AgentCard.personalPrefix, ownPortrait = AgentCard.headshotURL
        try Data([1,2,3]).write(to: ownPortrait)
        let otherOwner = UUID()
        UserDefaults.standard.set(otherOwner.uuidString, forKey: "auth.supabase.userID"); AuthStore.shared.userID = otherOwner.uuidString
        try expect(AgentCard.current.name.isEmpty && AgentCard.headshotURL != ownPortrait && AgentCard.current.headshotBase64 == nil, "Another account cannot inherit own text or portrait")
        UserDefaults.standard.set(owner.uuidString, forKey: "auth.supabase.userID"); AuthStore.shared.userID = owner.uuidString
        try expect(AgentCard.personalPrefix == ownerPrefix && AgentCard.current.name == nameOnly["name"], "Returning to own account restores its exact personal card")
        let migrationOwner = UUID(), originalOrg = UUID()
        let migrationKey = "brand.legacy.workspace." + migrationOwner.uuidString.lowercased()
        let provenPrefix = "workspace.\(migrationOwner.uuidString.lowercased()).\(originalOrg.uuidString.lowercased())."
        let invitedPrefix = "workspace.\(migrationOwner.uuidString.lowercased()).\(foreign.uuidString.lowercased())."
        UserDefaults.standard.set(originalOrg.uuidString.lowercased(), forKey: migrationKey)
        UserDefaults.standard.set("Proven original personal card", forKey: provenPrefix + "agent.name")
        UserDefaults.standard.set("Inviter cache", forKey: invitedPrefix + "agent.name")
        UserDefaults.standard.set(migrationOwner.uuidString, forKey: "auth.supabase.userID"); AuthStore.shared.userID = migrationOwner.uuidString
        defer {
            for key in UserDefaults.standard.dictionaryRepresentation().keys where key.hasPrefix(PersonalCardStore.prefix(migrationOwner)) || key.hasPrefix(provenPrefix) || key.hasPrefix(invitedPrefix) || key.hasPrefix(PersonalCardStore.prefix(otherOwner)) || key == migrationKey { UserDefaults.standard.removeObject(forKey: key) }
            AuthStore.shared.userID = owner.uuidString
        }
        try expect(WorkspaceContext.save(.init(selectedOrgID: foreign, workspaces: spaces), owner: migrationOwner), "Migration fixture selects inviter workspace")
        defer { UserDefaults.standard.removeObject(forKey: WorkspaceContext.key(migrationOwner)) }
        try expect(AgentCard.current.name == "Proven original personal card", "Migration recovers proven original card instead of inviter cache")
        UserDefaults.standard.set(owner.uuidString, forKey: "auth.supabase.userID"); AuthStore.shared.userID = owner.uuidString
        // Erase must remove actual legacy private text, not only a tombstone.
        UserDefaults.standard.set(migrationOwner.uuidString, forKey: "auth.supabase.userID"); AuthStore.shared.userID = migrationOwner.uuidString
        UserDefaults.standard.set("Erased bare contact", forKey: "agent.name")
        UserDefaults.standard.set(migrationOwner.uuidString.lowercased(), forKey: "brand.legacy.unattributedOwner")
        UserDefaults.standard.set(["name":"Erased archive", "phone":"5551112222"], forKey: "brand.archive.synthetic")
        UserDefaults.standard.set("Erased signature with contact", forKey: provenPrefix + "brand.lastPushed")
        PersonalCardStore.eraseDeviceCache()
        AgentCard.migrateLegacyIfNeeded(owner: migrationOwner, org: originalOrg)
        try expect(AgentCard.current.name.isEmpty, "Phone erase cannot resurrect contact through legacy migration")
        try expect(UserDefaults.standard.string(forKey: provenPrefix + "agent.name") == nil && UserDefaults.standard.string(forKey: invitedPrefix + "agent.name") == nil, "Phone erase removes actual original and inviter workspace contact text")
        try expect(UserDefaults.standard.object(forKey: "agent.name") == nil && UserDefaults.standard.object(forKey: "brand.archive.synthetic") == nil, "Phone erase removes bare legacy contact and archived card contents")
        try expect(UserDefaults.standard.object(forKey: migrationKey) == nil && UserDefaults.standard.object(forKey: "brand.legacy.unattributedOwner") == nil && UserDefaults.standard.object(forKey: provenPrefix + "brand.lastPushed") == nil, "Phone erase removes legacy attribution and contact signatures")
        UserDefaults.standard.set(owner.uuidString, forKey: "auth.supabase.userID"); AuthStore.shared.userID = owner.uuidString
        print("PROFILE_ASSERTIONS=\(assertions)")
    }
