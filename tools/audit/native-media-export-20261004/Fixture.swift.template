@main @MainActor enum Checks {
    static var count = 0
    static let boundary = PhotoBoundary.shared
    static var original: URL!
    static func check(_ value: Bool, _ label: String) {
        count += 1
        guard value else { print("FAIL: " + label); exit(1) }
    }
    static func until(_ label: String, _ predicate: () -> Bool) async {
        for _ in 0..<100_000 { if predicate() { return }; await Task.yield() }
        print("FAIL: held boundary timeout: " + label); exit(1)
    }
    static func reset() {
        AuthStore.shared.userID = "A"; AuthStore.shared.syncSessionRevision = 1
        WorkspaceContext.selectedOrgID = UUID(); Haptics.successes = 0
        boundary.reset(); URLSession.shared.reset()
    }
    static func change(_ mode: String, _ harness: Harness) {
        switch mode {
        case "account": AuthStore.shared.userID = "B"
        case "session": AuthStore.shared.syncSessionRevision += 1
        case "workspace": WorkspaceContext.selectedOrgID = UUID()
        case "listing": harness.model.listings[0].serverID = UUID()
        case "org": harness.model.listings[0].serverOrgID = UUID()
        case "deleted": harness.model.listings = []
        case "unavailable": harness.model.listings[0].cloudUnavailable = true
        default: preconditionFailure("Unknown synthetic context")
        }
    }
    static func sourceSafe() throws {
        check(try Data(contentsOf: original) == Data("synthetic-private-original".utf8), "source file survives rejected/completed export unchanged")
    }
    static func main() async throws {
        let root = URL(fileURLWithPath: CommandLine.arguments[1], isDirectory: true)
        URLSession.shared.root = root
        original = root.appendingPathComponent("source-original.jpg")
        try Data("synthetic-private-original".utf8).write(to: original)

        for mode in ["account", "workspace"] {
            reset(); let previous = Harness(); change(mode, previous)
            await previous.load()
            check(previous.model.api.provenanceCalls == 0 && previous.provenance.isEmpty,
                  "old presentation cannot schedule provenance for replacement actor or workspace")
            previous.csv()
            check(previous.model.api.csvCalls == 0 && previous.auditExport == nil,
                  "old presentation cannot schedule CSV for replacement actor or workspace")
            previous.local(original)
            check(boundary.writeAttempts == 0 && previous.savedFiles.isEmpty,
                  "old presentation cannot schedule Photos for replacement actor or workspace")
            try sourceSafe()
        }

        reset(); let normal = Harness(); await normal.load(); normal.originals()
        await until("normal original") { !normal.isSavingOriginals }
        check(URLSession.shared.downloads == 1 && boundary.completedWrites == 1, "valid original downloads and writes once")
        check(normal.complianceNote == "Saved 1 original to Photos." && Haptics.successes == 1, "valid original completion reports success")
        try sourceSafe()

        for mode in ["account", "session", "workspace", "listing", "org", "deleted", "unavailable"] {
            reset(); let changed = Harness(); await changed.load(); URLSession.shared.hold = true
            changed.originals(); await until("held download") { URLSession.shared.waiting }
            change(mode, changed); URLSession.shared.release()
            await until("rejected download") { !changed.isSavingOriginals }
            check(boundary.writeAttempts == 0, "changed download never writes Photos")
            check(URLSession.shared.downloads == 1 && URLSession.shared.urls.allSatisfy { !FileManager.default.fileExists(atPath: $0.path) }, "only returned owned downloads are removed")
            check(changed.complianceNote == nil && Haptics.successes == 0, "changed download never reports saved")
            try sourceSafe()
        }
        reset(); let stale = Harness(); await stale.load(); change("session", stale); stale.originals()
        check(URLSession.shared.downloads == 0 && boundary.writeAttempts == 0, "stale loaded provenance cannot start a download")

        for video in [false, true] {
            for mode in ["account", "session", "workspace", "listing", "org", "deleted", "unavailable"] {
                reset(); boundary.reset(.notDetermined); let changed = Harness()
                changed.local(original, video: video)
                await until("local permission") { boundary.waitingPermission }
                change(mode, changed); boundary.permit(.authorized)
                await until("local denied context") { !changed.isSavingFile }
                check(boundary.writeAttempts == 0, "permission change prevents Photos transaction")
                check(changed.savedFiles.isEmpty && changed.filesNote == nil && Haptics.successes == 0, "stale local completion remains silent")
                try sourceSafe()
            }
            reset(); let normalFile = Harness(); normalFile.local(original, video: video)
            await until("normal file") { !normalFile.isSavingFile }
            check(boundary.completedWrites == 1 && normalFile.savedFiles.count == 1, "valid photo/video writes and confirms once")
            reset(); boundary.reset(.notDetermined); let denied = Harness(); denied.local(original, video: video)
            await until("denied permission") { boundary.waitingPermission }; boundary.permit(.denied)
            await until("denied completion") { !denied.isSavingFile }
            check(boundary.writeAttempts == 0 && denied.filesNoteOK == false && denied.filesNote != nil, "permission denial reports failure without writing")
            reset(); boundary.reset(.authorized, hold: true); let begun = Harness(); begun.local(original, video: video)
            await until("begun write") { boundary.waitingWrite }; change("session", begun); boundary.completeWrite()
            await until("begun completion") { !begun.isSavingFile }
            check(boundary.completedWrites == 1 && begun.savedFiles.isEmpty && Haptics.successes == 0, "already begun Photos completion cannot mark replacement session saved")
            try sourceSafe()
        }
        for video in [false, true] {
            reset(); boundary.reset(.notDetermined)
            let task = Task { @MainActor in
                do {
                    if video { try await PhotosLibrarySaver.saveVideo(at: original) }
                    else { try await PhotosLibrarySaver.saveImageFile(at: original) }
                    return false
                } catch { return true }
            }
            await until("cancel permission") { boundary.waitingPermission }; task.cancel(); boundary.permit(.authorized)
            check(await task.value, "cancelled direct photo/video save throws")
            check(boundary.writeAttempts == 0, "cancelled permission causes no Photos transaction")
        }
        for mode in ["account", "session", "workspace", "listing", "org", "deleted", "unavailable"] {
            reset(); let audit = Harness(); audit.model.api.hold = true; audit.csv()
            await until("held CSV") { audit.model.api.waiting }; change(mode, audit); audit.model.api.release()
            await until("CSV completion") { !audit.isExportingAudit }
            check(audit.auditExport == nil && Haptics.successes == 0, "stale CSV response never reaches Files handoff")
            try sourceSafe()
        }
        reset(); let audit = Harness(); audit.csv(); await until("valid CSV") { !audit.isExportingAudit }
        check(audit.auditExport != nil && Haptics.successes == 1, "valid CSV reaches Files handoff")
        let exported = audit.auditExport!.url
        check(try Data(contentsOf: exported) == Data("Synthetic A private audit".utf8), "CSV handoff retains exact returned bytes")
        try FileManager.default.removeItem(at: exported.deletingLastPathComponent())
        print("PASS: \(count) native media export assertions")
    }
}
