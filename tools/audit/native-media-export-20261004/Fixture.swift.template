    static func creationRequestForAssetFromImage(atFileURL url: URL) -> Int { PhotoBoundary.shared.create(); return 1 }
    static func creationRequestForAssetFromVideo(atFileURL url: URL) -> Int { PhotoBoundary.shared.create(); return 1 }
}
