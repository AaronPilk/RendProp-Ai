@MainActor final class URLSession {
    static let shared = URLSession()
    var waiting = false
    var hold = false
    var continuation: CheckedContinuation<Void, Never>?
    var downloads = 0
    var urls: [URL] = []
    var root: URL!
    func reset() { waiting = false; hold = false; continuation = nil; downloads = 0; urls = [] }
    func download(from remote: URL) async throws -> (URL, URLResponse) {
        precondition(remote.host == "synthetic.invalid")
        downloads += 1
        let url = root.appendingPathComponent("returned-download-" + UUID().uuidString)
        try Data("synthetic-private-original".utf8).write(to: url)
        urls.append(url)
        if hold { waiting = true; await withCheckedContinuation { continuation = $0 } }
        return (url, HTTPURLResponse(url: remote, statusCode: 200, httpVersion: nil, headerFields: nil)!)
    }
    func release() { waiting = false; let saved = continuation; continuation = nil; hold = false; saved?.resume() }
}
@MainActor final class API {
    var provenanceCalls = 0
    var csvCalls = 0
    var waiting = false
    var hold = false
    var continuation: CheckedContinuation<Void, Never>?
    func provenance(listingServerID: UUID) async throws -> [ProvenanceRecord] {
        provenanceCalls += 1
        return [ProvenanceRecord(originalURL: URL(string: "https://synthetic.invalid/A-original.jpg"))]
    }
    func complianceCSV(listingServerID: UUID) async throws -> Data {
        csvCalls += 1
        if hold { waiting = true; await withCheckedContinuation { continuation = $0 } }
        return Data("Synthetic A private audit".utf8)
    }
    func release() { waiting = false; let saved = continuation; continuation = nil; hold = false; saved?.resume() }
}
