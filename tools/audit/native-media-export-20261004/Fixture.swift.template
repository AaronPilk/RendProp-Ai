import Foundation

// Platform boundaries only. Actual save/permission/caller bodies are inserted
// below unchanged; these doubles never import UIKit or Photos.
struct UIImage {}
enum PHAccessLevel { case addOnly }
enum PHAuthorizationStatus { case notDetermined, authorized, limited, denied }
enum FakeError: Error { case failedWrite }

final class PhotoBoundary {
    static let shared = PhotoBoundary()
    private let lock = NSLock()
    private var status: PHAuthorizationStatus = .authorized
    private var permission: CheckedContinuation<PHAuthorizationStatus, Never>?
    private var write: CheckedContinuation<Void, Error>?
    private var holdWrite = false, failWrite = false
    private var attempts = 0, creations = 0, successes = 0
    private func locked<T>(_ body: () -> T) -> T { lock.lock(); defer { lock.unlock() }; return body() }
    func reset(_ status: PHAuthorizationStatus = .authorized, hold: Bool = false, fail: Bool = false) {
        locked { precondition(permission == nil && write == nil); self.status = status
            holdWrite = hold; failWrite = fail; attempts = 0; creations = 0; successes = 0 }
    }
    var authorization: PHAuthorizationStatus { locked { status } }
    var waitingPermission: Bool { locked { permission != nil } }
    var waitingWrite: Bool { locked { write != nil } }
    var writeAttempts: Int { locked { attempts } }
    var creationRequests: Int { locked { creations } }
    var completedWrites: Int { locked { successes } }
    func request(_ continuation: CheckedContinuation<PHAuthorizationStatus, Never>) { locked { permission = continuation } }
    func permit(_ status: PHAuthorizationStatus) {
        let continuation = locked { let c = permission; permission = nil; self.status = status; return c }
        precondition(continuation != nil); continuation?.resume(returning: status)
    }
    func beginWrite() { locked { attempts += 1 } }
    func create() { locked { creations += 1 } }
    func finish(_ continuation: CheckedContinuation<Void, Error>) {
        let flags = locked { () -> (Bool, Bool) in
            if holdWrite { write = continuation }
            return (holdWrite, failWrite)
        }
        guard !flags.0 else { return }
        if flags.1 { continuation.resume(throwing: FakeError.failedWrite) }
        else { locked { successes += 1 }; continuation.resume() }
    }
    func completeWrite() {
        let continuation = locked { let c = write; write = nil; successes += 1; return c }
        precondition(continuation != nil); continuation?.resume()
    }
}

final class PHPhotoLibrary {
    static let instance = PHPhotoLibrary()
    static func shared() -> PHPhotoLibrary { instance }
    static func authorizationStatus(for level: PHAccessLevel) -> PHAuthorizationStatus { PhotoBoundary.shared.authorization }
    static func requestAuthorization(for level: PHAccessLevel) async -> PHAuthorizationStatus {
        await withCheckedContinuation { PhotoBoundary.shared.request($0) }
    }
    func performChanges(_ changes: @escaping () -> Void) async throws {
        PhotoBoundary.shared.beginWrite(); changes()
        try await withCheckedThrowingContinuation { PhotoBoundary.shared.finish($0) }
    }
}
