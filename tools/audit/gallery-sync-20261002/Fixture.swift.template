@MainActor final class Hold<T> {
    private var continuation: CheckedContinuation<T, Error>?
    var reached = false
    func suspend() async throws -> T {
        precondition(!reached, "A held boundary is called once")
        reached = true
        return try await withCheckedThrowingContinuation { continuation = $0 }
    }
    func resume(_ value: T) { let saved = continuation; continuation = nil; saved!.resume(returning: value) }
    func fail(_ error: Error) { let saved = continuation; continuation = nil; saved!.resume(throwing: error) }
}
@MainActor final class UploadManager {
    static let shared = UploadManager()
    var calls: [(URL, UUID)] = []
    var boundary: ((URL, UUID) async throws -> String)?
    func uploadGalleryPhoto(fileURL: URL, listingID: UUID) async throws -> String {
        precondition(fileURL.path.hasPrefix(FileStore.documents.path + "/"))
        calls.append((fileURL, listingID))
        if let boundary { return try await boundary(fileURL, listingID) }
        return "asset:" + fileURL.lastPathComponent
    }
    func reset() { calls = []; boundary = nil }
}
@MainActor final class API {
    struct Selection: Equatable { var serverID: UUID; var assetIDs: [String]; var main: String? }
    var selectionAttempts: [Selection] = []
    var publications: [Selection] = []
    var appendAttempts: [Selection] = []
    var provenance: [String] = []
    var selectBoundary: (() async throws -> Void)?
    var attachBoundary: (() async throws -> Void)?
    func selectListingPhotos(serverID: UUID, galleryAssetIDs: [String], mainAssetID: String?) async throws {
        let selection = Selection(serverID: serverID, assetIDs: galleryAssetIDs, main: mainAssetID)
        selectionAttempts.append(selection)
        try await selectBoundary?()
        publications.append(selection)
    }
    func addListingPhotos(serverID: UUID, assetIDs: [String], mainAssetID: String?) async throws {
        let selection = Selection(serverID: serverID, assetIDs: assetIDs, main: mainAssetID)
        appendAttempts.append(selection)
        try await selectBoundary?()
        publications.append(selection)
    }
    func attachProvenanceMedia(provenanceID: String, originalAssetID: String?, alteredAssetID: String) async throws {
        provenance.append(provenanceID)
        try await attachBoundary?()
    }
}
