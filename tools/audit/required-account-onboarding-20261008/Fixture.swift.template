// Closed state/transport doubles: no host preferences, Keychain or networking.
final class UserDefaults {
    static let standard = UserDefaults()
    var values: [String: Any] = [:]
    func string(forKey key: String) -> String? { values[key] as? String }
    func double(forKey key: String) -> Double { values[key] as? Double ?? 0 }
    func set(_ value: Any?, forKey key: String) { values[key] = value }
    func removeObject(forKey key: String) { values[key] = nil }
}
enum UIApplication { static let didBecomeActiveNotification = Notification.Name("synthetic-foreground") }
enum Config {
    static var enableAuth = true, isUITesting = false, isSessionNetworkTesting = false
    static var isOfflineAccountFixture: Bool { isUITesting && !isSessionNetworkTesting }
    static let supabaseURL = URL(string: "https://synthetic.invalid")
    static let supabaseAnonKey = "synthetic-public-fixture"
}
enum APIError: Error { case badResponse }
@MainActor final class URLSession {
    static let shared = URLSession()
    var requests = [URLRequest](), status = 200, bytes = Data()
    var held: CheckedContinuation<Void, Never>?, holdNext = false
    func data(for request: URLRequest) async throws -> (Data, URLResponse) {
        precondition(request.url?.host == "synthetic.invalid")
        precondition(request.url?.query == "grant_type=refresh_token")
        requests.append(request)
        let response = (bytes, HTTPURLResponse(url: request.url!, statusCode: status, httpVersion: nil, headerFields: nil)!)
        if holdNext { holdNext = false; await withCheckedContinuation { held = $0 } }
        return response
    }
}
// The push cleanup and purchase presentation side effects are checked separately.
@MainActor final class PushManager { static let shared = PushManager(); func accountWillChange() {}; func accountDidChange() {} }
@MainActor final class PurchaseManager { static let shared = PurchaseManager(); func clearAccountPresentation() {} }
@MainActor enum AccountLocalPreferences { static func activate(previous: UUID?, next: UUID) {} }
@MainActor final class AuthStore {
    static var shared: AuthStore!
    static var access: String?, refresh: String?
    static var tokenExpiresAt: Date? {
        let value = UserDefaults.standard.double(forKey: Keys.expiresAt)
        return value > 0 ? Date(timeIntervalSince1970: value) : nil
    }
    static var storageReads = 0, credentialWrites = 0
    static func storedAccessToken() -> String? { storageReads += 1; return access }
    static func storedRefreshToken() -> String? { storageReads += 1; return refresh }
    static func persistTokens(access: String, refresh: String?, expiresAt: Date?) {
        credentialWrites += 1; Self.access = access; Self.refresh = refresh
        if let expiresAt { UserDefaults.standard.set(expiresAt.timeIntervalSince1970, forKey: Keys.expiresAt) }
    }
    static func clearTokens() { access = nil; refresh = nil; UserDefaults.standard.removeObject(forKey: Keys.expiresAt) }
    enum Keys { static let accessToken="access", refreshToken="refresh", userID="owner", userName="name", orgName="org", expiresAt="expiry" }
    var isSignedIn: Bool, isIdentified = false, userID: String?
    var displayName: String, userName: String, orgName: String
    var foregroundObserver: NSObjectProtocol?
    var sessionEpoch: UInt64 = 0, syncIdentityEpoch: UInt64 = 0
    var anonymousBootstrap: Task<Void, Never>?, refreshInFlight: Task<Bool, Never>?, autoRefreshTask: Task<Void, Never>?
    var onAccountChanged: ((UUID) -> Void)?
    var adoptionDiscarded = 0, refreshCalls = 0
    var connection = Connection()
    final class Connection {
        var calls = 0, cancellations = 0
        func cancelAll() { cancellations += 1 }
        func connect() async -> Bool { calls += 1; return false }
    }
    func scheduleAutoRefresh() {}
    func refreshIfNeeded() async -> Bool { refreshCalls += 1; return true }
    func retryPendingAdoptionIfNeeded() async {}
    func discardPendingAdoption() { adoptionDiscarded += 1 }
    static func authError(status: Int, data: Data) -> APIError { .badResponse }
__AUTH_METHODS__
    func tokenForTest() -> String? { validatedCurrentAccessToken() }
    func refreshForTest() async -> Bool { await performRefresh() }
    func applyForTest(_ token: String) -> Bool { applySession(accessToken: token, refreshToken: "synthetic", expiresAt: Date().addingTimeInterval(3600)) }
}
