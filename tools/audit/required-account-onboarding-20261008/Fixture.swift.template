@MainActor final class RefreshProbe {
    var isSignedIn = true, refreshes = 0
    static var tokenExpiresAt: Date? { AuthStore.tokenExpiresAt }
    static func storedRefreshToken() -> String? { AuthStore.refresh }
    func signOut(preservingAdoption: Bool = false) { isSignedIn = false }
    func runRefresh() async -> Bool { refreshes += 1; return false }
__REFRESH_IF_NEEDED__
}
