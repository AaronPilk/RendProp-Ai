@MainActor final class WireClient {
    enum Idempotency { case none, key(String) }
    var requests: [URLRequest] = []
    var response = Data()
    func url(_ pieces: [String]) -> URL { URL(string: "https://fixture.invalid/" + pieces.joined(separator: "/"))! }
    func makeRequest(url: URL, method: String, json: [String: Any], idempotency: Idempotency = .none) -> URLRequest {
        var request = URLRequest(url: url); request.httpMethod = method
        request.httpBody = try! JSONSerialization.data(withJSONObject: json)
        if case .key(let key) = idempotency { request.setValue(key, forHTTPHeaderField: "Idempotency-Key") }
        return request
    }
    func execute(_ request: URLRequest) async throws -> Data { requests.append(request); return response }
    func body(_ listing: Listing, patch: Bool) throws -> [String: Any] { try listingBody(listing, forPatch: patch) }
    func mapped(_ data: Data) throws -> Listing { mapListing(try decode(data)) }
