        try check(downgradedSnapshot.floorMeasurements == nil && downgradedSnapshot.details?[FloorMeasurementPlan.wireKey] == savedOutlineWire,
                  "The actual older Listing snapshot decoder refuses typed v2 and retains its exact mirrored raw wire")
        try check(try LegacySnapshotWireDetails.merged(downgradedSnapshot)[FloorMeasurementPlan.wireKey] == savedOutlineWire,
                  "The older snapshot write path preserves mirrored outline wire on unrelated facts edits")
        let upgradedSnapshot = try JSONDecoder().decode(Listing.self, from: JSONEncoder().encode(downgradedSnapshot))
        try check(upgradedSnapshot.floorMeasurements == editorSaved.floorMeasurements && upgradedSnapshot.sqft == local.sqft,
                  "The current app recovers the exact outline after a supported old-reader snapshot round trip")
        editor.currentContext = false
        try refuses({ try editor.save(outlineNewer) }, "Actual editor refuses to save an outline after an account or workspace context change")
        var clearedOutline = outlineLocal
        clearedOutline.floorMeasurements = FloorMeasurementPlan(version: 2, rooms: [], outlines: [], updatedAt: fixedDate)
        let emptyOutlineWire = (try client.body(clearedOutline, patch: false)["details"] as! [String: String])[FloorMeasurementPlan.wireKey]!
        try check(FloorMeasurementPlan.decodeWireValue(emptyOutlineWire)?.isEmpty == true && emptyOutlineWire != outlineWire,
                  "Deleting the last outline writes a supported empty version-two plan as an intentional clear")
        var unknownOutlineObject = try JSONSerialization.jsonObject(with: Data(outlineWire.utf8)) as! [String: Any]
        var unknownOutlines = unknownOutlineObject["outlines"] as! [[String: Any]]
        unknownOutlines[0]["category"] = "future-category"
        unknownOutlineObject["outlines"] = unknownOutlines
        let unknownOutlineWire = String(decoding: try JSONSerialization.data(withJSONObject: unknownOutlineObject), as: UTF8.self)
        outlineResponse["details"] = [FloorMeasurementPlan.wireKey: unknownOutlineWire]
        let unsupportedOutline = try client.mapped(JSONSerialization.data(withJSONObject: outlineResponse))
        try check(unsupportedOutline.floorMeasurements == nil && unsupportedOutline.details?[FloorMeasurementPlan.wireKey] == unknownOutlineWire,
                  "An unsupported outline category preserves raw wire while ordinary listing facts remain readable")
        try check(try ListingWireDetails.merged(unsupportedOutline)[FloorMeasurementPlan.wireKey] == unknownOutlineWire,
                  "An unsupported outline category is never silently replaced by an empty current plan")
        var badOutline = outlineLocal
        badOutline.floorMeasurements?.outlines[0].vertices[1].x = .infinity
        let beforeBadOutline = client.requests.count
        try refuses({ _ = try client.body(badOutline, patch: true) }, "Nonfinite outline vertices fail before any actual HTTP request")
        try check(client.requests.count == beforeBadOutline, "Invalid outline validation has no HTTP side effects")

        let outlineFingerprint = try CloudDraftCreation.fingerprint(outlineLocal)
        var outlineEdit = outlineLocal; outlineEdit.floorMeasurements = outlineNewer
        try check(try CloudDraftCreation.fingerprint(outlineEdit) != outlineFingerprint,
                  "Outline-only edits change the actual create fingerprint")
        var outlineRemote = outlineMapped
        outlineRemote.floorMeasurements = outlineNewer
        outlineRemote.details?[FloorMeasurementPlan.wireKey] = outlineNewerWire
        let outlineClean = try CloudListingMerge.merge(local: [outlineLocal], remote: [outlineRemote], protected: [])[0]
        try check(outlineClean.floorMeasurements == outlineNewer && outlineClean.mainPhotoRelPath == outlineLocal.mainPhotoRelPath,
                  "Clean remote hydration adopts outline-only data and preserves local photos")
        var outlineDirty = outlineLocal; outlineDirty.needsServerSync = true
        try check(try CloudListingMerge.merge(local: [outlineDirty], remote: [outlineRemote], protected: [])[0].floorMeasurements == outlinePlan,
                  "Dirty irregular outlines survive an older remote snapshot")
        try check(try CloudListingMerge.merge(local: [outlineLocal], remote: [outlineRemote], protected: [localID])[0].floorMeasurements == outlinePlan,
                  "Protected irregular outlines survive a concurrent refresh")
        try check(try CloudListingMerge.merge(local: [outlineLocal], remote: [oldCloud], protected: [])[0].floorMeasurements == nil,
                  "Clean outline-only plans observe authoritative remote deletion")
        try check(try CloudListingMerge.merge(local: [outlineDirty], remote: [oldCloud], protected: [])[0].floorMeasurements == outlinePlan,
                  "Dirty outline-only plans survive remote absence until their write is acknowledged")
        try check(try CloudListingMerge.merge(local: [outlineLocal], remote: [unsupportedOutline], protected: [])[0].details?[FloorMeasurementPlan.wireKey] == unknownOutlineWire,
                  "Clean outline-only plans adopt future raw content rather than resurrecting a stale typed outline")

        var outlineDraft = outlineLocal; outlineDraft.serverID = nil; outlineDraft.serverOrgID = nil; outlineDraft.measurementSync = nil
        outlineDraft.cloudCreateFingerprint = try CloudDraftCreation.fingerprint(outlineDraft)
        var outlineReplay = outlineRemote; outlineReplay.cloudCreateReplayed = true
        current = outlineDraft
        _ = try await CloudDraftCreation.ensure(snapshot: outlineDraft, identity: identity, create: { _ in outlineReplay }, current: { current }, activeIdentity: { activeIdentity }, save: { current = $0 }, deleteRemoved: { _ in })
        try check(current?.floorMeasurements == outlineNewer && current?.needsServerSync == false,
                  "An unedited outline-only create replay adopts the office outline")
        current = outlineDraft; current?.floorMeasurements = outlineNewer
        _ = try await CloudDraftCreation.ensure(snapshot: outlineDraft, identity: identity, create: { _ in outlineReplay }, current: { current }, activeIdentity: { activeIdentity }, save: { current = $0 }, deleteRemoved: { _ in })
        try check(current?.floorMeasurements == outlineNewer && current?.needsServerSync == true && current?.measurementSync?.pending == true && current?.measurementSync?.factsReviewRequired == true,
                  "An old outline-only create replay stages CAS and requires ordinary-facts review")
        var priorOutlineDraft = outlineDraft
        priorOutlineDraft.cloudCreateFingerprint = try priorFingerprint(priorOutlineDraft)
        current = priorOutlineDraft; current?.floorMeasurements = outlineNewer
        _ = try await CloudDraftCreation.ensure(snapshot: priorOutlineDraft, identity: identity, create: { _ in outlineReplay }, current: { current }, activeIdentity: { activeIdentity }, save: { current = $0 }, deleteRemoved: { _ in })
        try check(current?.floorMeasurements == outlineNewer && current?.needsServerSync == true && current?.measurementSync?.factsReviewRequired == true,
                  "Legacy raw fingerprints cannot overlook an independent outline edit")
        var alignedOutlineDraft = outlineDraft
        alignedOutlineDraft.details?[FloorMeasurementPlan.wireKey] = outlineWire
        alignedOutlineDraft.cloudCreateFingerprint = try priorFingerprint(alignedOutlineDraft)
        current = alignedOutlineDraft
        _ = try await CloudDraftCreation.ensure(snapshot: alignedOutlineDraft, identity: identity, create: { _ in outlineReplay }, current: { current }, activeIdentity: { activeIdentity }, save: { current = $0 }, deleteRemoved: { _ in })
        try check(current?.floorMeasurements == outlineNewer && current?.needsServerSync == false,
                  "An unedited outline matching raw wire remains compatible with a pending legacy create fingerprint")

        // The actual anonymous-account journal rebinds identities only. It
        // must preserve the newer local outline, its raw wire and listing area.
        let adoption = AnonymousAdoptionRecovery.Pending(version: 1, operationID: UUID(), sourceUserID: org,
            destinationUserID: otherOrg, sourceAccessToken: "inert-fixture-token", sourceRefreshToken: nil)
        let journal = try AdoptionLocalBindings.capture(adoption, listings: [outlineLocal])
        var detachedOutline = outlineEdit; detachedOutline.serverID = nil
        let adopted = try journal.restoring([detachedOutline], pending: adoption, currentUserID: otherOrg, orgID: org)[0]
        try check(adopted.floorMeasurements == outlineNewer && adopted.details == outlineEdit.details && adopted.needsServerSync == true,
                  "Actual anonymous adoption preserves current outlines and raw wire while marking the rebound listing dirty")
        try check(adopted.sqft == local.sqft && adopted.serverID == sid,
                  "Anonymous adoption rebinds the same listing without replacing advertised area")
        try check(try CloudDraftCreation.fingerprint(adopted) == CloudDraftCreation.fingerprint(outlineEdit),
                  "Anonymous adoption does not change the facts fingerprint of an outline-only measurement plan")
        try refuses({ _ = try journal.restoring([detachedOutline], pending: adoption, currentUserID: org, orgID: org) },
                    "Another account cannot adopt an irregular outline through a foreign handoff")

        var acknowledgedOutline = outlineLocal
        acknowledgedOutline.details?[FloorMeasurementPlan.wireKey] = outlineWire
        acknowledgedOutline.measurementSync = FloorMeasurementSyncState(expected: outlineWire)
        let outlineModel = SyncModel(acknowledgedOutline), outlineUpdateGate = HeldBoundary()
        outlineModel.api.measurementUpdate = { snapshot in await outlineUpdateGate.hold(); return snapshot }
        try outlineModel.saveMeasurements(outlineNewer, for: localID)
        try await waitUntil { outlineUpdateGate.arrivals == 1 }
        try check(outlineModel.listings[0].measurementSync?.pending == true && outlineModel.api.measurementSnapshots[0].floorMeasurements == outlineNewer && outlineModel.api.snapshots.isEmpty,
                  "Actual saveMeasurements sends an outline-only edit through CAS without generic facts CAS")
        try outlineModel.saveMeasurements(clearedOutline.floorMeasurements!, for: localID)
        outlineUpdateGate.release()
        try await waitUntil { outlineUpdateGate.arrivals == 2 }
        try check(outlineModel.api.measurementSnapshots[1].floorMeasurements?.isEmpty == true && outlineModel.listings[0].measurementSync?.pending == true && outlineModel.api.snapshots.isEmpty,
                  "Deleting the last outline during held CAS dispatches a second empty version-two write")
        outlineUpdateGate.release()
        try await waitUntil { !outlineModel.syncInFlight.contains(localID) }
        try check(outlineModel.listings[0].floorMeasurements?.isEmpty == true && outlineModel.listings[0].measurementSync?.pending == false && outlineModel.api.snapshots.isEmpty,
                  "Only acknowledgement of the latest outline clear removes its CAS queue")
        print("PASS: \(checks) assertions; actual wire/create/facts CAS/dirty-sync/replay/adoption sources plus frozen v1 reader; zero network or camera calls")
    }
}
