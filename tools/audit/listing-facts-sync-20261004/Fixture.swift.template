@MainActor final class HeldBoundary {
    var arrivals = 0
    private var continuation: CheckedContinuation<Void, Never>?
    func hold() async {
        arrivals += 1
        await withCheckedContinuation { continuation = $0 }
    }
    func release() { let saved = continuation; continuation = nil; saved?.resume() }
}
