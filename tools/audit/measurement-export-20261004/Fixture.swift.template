func coarseCoordinate(_ value: Double) -> Double { (value * 1000).rounded() / 1000 }
struct AssertionFailure: Error { let message: String }
enum PDFCapture {
    struct PositionedText { let text: String; let y: CGFloat; let width: CGFloat; let height: CGFloat }
    static var pages: [[String]] = []
    static var positioned: [[PositionedText]] = []
    static var rectangles: [[CGRect]] = []
    static var pageBounds = CGRect.zero
    static var transform = CGAffineTransform.identity
    static var saves: [Int] = [], restores: [Int] = [], concatenations: [Int] = []
    static var finalStateBalanced = false
    static func append(_ text: String, rectangle: CGRect) {
        pages[pages.count - 1].append(text)
        positioned[positioned.count - 1].append(PositionedText(text: text, y: rectangle.minY, width: rectangle.width, height: rectangle.height))
        appendRectangle(rectangle)
    }
    static func appendRectangle(_ rectangle: CGRect) {
        rectangles[rectangles.count - 1].append(rectangle.applying(transform))
    }
}
struct UIImage { func draw(in rectangle: CGRect) { PDFCapture.appendRectangle(rectangle) } }
struct UIFont {
    static func boldSystemFont(ofSize size: CGFloat) -> UIFont { UIFont() }
    static func systemFont(ofSize size: CGFloat) -> UIFont { UIFont() }
}
struct UIColor { static let black = UIColor() }
extension NSAttributedString.Key { static let font = NSAttributedString.Key("synthetic-font"); static let foregroundColor = NSAttributedString.Key("synthetic-color") }
extension NSString {
    func draw(in rectangle: CGRect, withAttributes attributes: [NSAttributedString.Key: Any]) { PDFCapture.append(self as String, rectangle: rectangle) }
}
// Capture the real production transform at the graphics boundary. CoreGraphics
// affine math remains real; glyph/image rasterization remains deliberately inert.
final class CapturedCGContext {
    private var stack: [CGAffineTransform] = []
    func saveGState() { stack.append(PDFCapture.transform); PDFCapture.saves[PDFCapture.saves.count - 1] += 1 }
    func concatenate(_ value: CGAffineTransform) {
        PDFCapture.transform = PDFCapture.transform.concatenating(value)
        PDFCapture.concatenations[PDFCapture.concatenations.count - 1] += 1
    }
    func restoreGState() {
        PDFCapture.transform = stack.removeLast()
        PDFCapture.restores[PDFCapture.restores.count - 1] += 1
    }
    var balanced: Bool { stack.isEmpty && PDFCapture.transform == .identity }
}
final class UIGraphicsPDFRendererContext {
    let cgContext = CapturedCGContext()
    func beginPage() {
        PDFCapture.pages.append([]); PDFCapture.positioned.append([]); PDFCapture.rectangles.append([])
        PDFCapture.saves.append(0); PDFCapture.restores.append(0); PDFCapture.concatenations.append(0)
    }
}
final class UIGraphicsPDFRenderer {
    init(bounds: CGRect) { PDFCapture.pageBounds = bounds }
    func writePDF(to url: URL, withActions body: (UIGraphicsPDFRendererContext) -> Void) throws {
        PDFCapture.pages = []; PDFCapture.positioned = []; PDFCapture.rectangles = []
        PDFCapture.saves = []; PDFCapture.restores = []; PDFCapture.concatenations = []
        PDFCapture.transform = .identity
        let context = UIGraphicsPDFRendererContext(); body(context)
        PDFCapture.finalStateBalanced = context.cgContext.balanced
    }
}
