struct ActualPDF {
    static func capture(plan: FloorMeasurementPlan, floor: Int, address: String) throws -> [[String]] {
        try plan.validate()
        let allRows = try plan.worksheet()
        let title = address.isEmpty ? "Floor plan and measurements" : address
        let floors = Array(Set(allRows.map(\.floor))).sorted()
        let floorImages = Dictionary(uniqueKeysWithValues: floors.map { ($0, UIImage()) })
        let url = URL(fileURLWithPath: "/synthetic-export-no-files-written.pdf")
        __PDF_CONSTRUCTOR__
__PDF_WRITE__
        return PDFCapture.pages
    }
__DRAW_TEXT__
}
