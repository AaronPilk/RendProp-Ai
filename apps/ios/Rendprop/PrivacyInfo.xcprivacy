<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Rendprop privacy manifest. Required-reason APIs + data-collection
       declarations for App Store review (ITMS-91053). -->
  <!-- STILL FALSE, and deliberately so, even though the owner runs Meta ads.
       Apple defines tracking as linking this app's data with data from other
       companies' apps or websites for targeted advertising or ad measurement,
       or sharing it with a data broker. Rendprop does none of that: there is no
       ad SDK, no IDFA, no ATT prompt, no pixel and no third-party analytics.
       Attribution is SKAdNetwork ONLY (Info.plist SKAdNetworkItems +
       Analytics/Attribution.swift), where iOS itself sends a signed postback
       carrying a campaign id and a conversion value and NO identifier — Apple
       expressly does not classify that as tracking. Product analytics is
       first-party: our own POST /events, our own Postgres, read only by the
       owner. -->
  <key>NSPrivacyTracking</key>
  <false/>
  <key>NSPrivacyTrackingDomains</key>
  <array/>

  <key>NSPrivacyCollectedDataTypes</key>
  <array>
    <!-- Email + name from Sign in with Apple (account, not tracking, not ads). -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeEmailAddress</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeName</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>
    <!-- Account identifier: the Supabase auth user id / session that every
         listing, tour and lead is linked to (account functionality only). -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeUserID</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>
    <!-- Photos/videos the user captures or imports to build a tour. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePhotosorVideos</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>
    <!-- Location of the LISTING, used to place its map pin and to derive the
         city/state region label. Two sources, both stored on the listing and
         uploaded with it: (a) a one-shot Core Location fix requested at
         kCLLocationAccuracyHundredMeters and rounded to 3 decimals, and (b) a
         forward geocode of the street address the user typed.
         MUST BE DECLARED PRECISE, NOT COARSE: Apple defines Precise Location as
         "the same or greater resolution as a latitude and longitude with three
         or more decimal places", and both sources land at or above that. The
         matching App Store Connect answer is Location -> Precise Location:
         Yes / Linked to the user / Not used for tracking / App Functionality. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePreciseLocation</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>
    <!-- Agent card phone number, shown on the agent's public tour pages. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePhoneNumber</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>
    <!-- Listing street address the user enters — it's the product being toured. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePhysicalAddress</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>
    <!-- Listing details/story text (taglines, room notes, business details). -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeOtherUserContent</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>
    <!-- Product interaction. TWO sources, and the stricter one sets the answer:
           (a) tour view metering (view counts on shared tours) — not linked to
               any viewer identity;
           (b) the first-party product funnel (Analytics/Analytics.swift ->
               POST /events): which screens and features were used, as a name
               from a fixed 19-word vocabulary plus a few enum/count props. The
               server attaches the signed-in account id when there is one, so
               this IS linked and is declared linked.
         DeveloperAdvertising is declared because the same milestones drive the
         SKAdNetwork conversion value, which measures how well the owner's own
         Meta ads perform. It is still not tracking: nothing is joined with any
         other company's data and nothing goes to a data broker.
         NO PII is in any of it — no e-mail, name, address, phone, photo, file
         path, listing id or coordinate. Enforced three times: a fixed event
         vocabulary, a per-event props whitelist, and a server-side regex scrub
         (services/supabase/functions/events). -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeProductInteraction</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
        <string>NSPrivacyCollectedDataTypePurposeDeveloperAdvertising</string>
      </array>
    </dict>
    <!-- Device ID: a UUID this app generates on first launch and keeps in its
         own Keychain item, sent with every analytics batch so the funnel can
         count PEOPLE instead of taps. It is NOT the IDFA (never requested, no
         ATT prompt), NOT the IDFV, and not derivable from either; it is not
         shared with anyone and never leaves our own backend. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeDeviceID</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
        <string>NSPrivacyCollectedDataTypePurposeDeveloperAdvertising</string>
      </array>
    </dict>
    <!-- Crash data: MetricKit crash SUMMARIES (Analytics/CrashReporter.swift).
         A kind, a signal or exception number, a termination reason clipped to
         120 characters with path-shaped tokens removed, and ONE frame name.
         Never the full call stack — that stays in Xcode Organizer, which Apple
         already provides. No third-party crash SDK is in the app. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeCrashData</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>
    <!-- Performance data: MetricKit hang / CPU / disk-write exceptions and a
         median launch time, all from the same subscriber, all as one small
         number or category each. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePerformanceData</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>
    <!-- Apple's signed transaction: transaction id, original transaction id,
         product id, environment and expiry, stored server-side to unlock the
         plan (migration 0019). No card details ever reach us. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePurchaseHistory</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>
  </array>

  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <!-- UserDefaults (appearance, onboarding, agent card, non-secret prefs, and
         analytics: the SKAdNetwork conversion-value high-water mark, the
         "has ever signed in" flag, and the device-id fallback used when the
         Keychain is unreachable before first unlock). All of it is this app's
         own data, read and written only by this app — CA92.1. -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array><string>CA92.1</string></array>
    </dict>
    <!-- File timestamps (creation/modification dates on captured media + AI edits). -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array><string>C617.1</string></array>
    </dict>
    <!-- Disk space (FileStore.freeSpaceBytes → volumeAvailableCapacityForImportantUsage).
         BOTH approved reasons apply and both are declared:
           E174.1 — CameraManager.startRecording() refuses a take that would not
                    fit, so nothing is half-written.
           85F4.1 — the same check DISPLAYS the numbers to the user
                    ("…needs about 12 GB free, and only 3.1 GB is left").
         Never leaves the device. -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>E174.1</string>
        <string>85F4.1</string>
      </array>
    </dict>
    <!-- systemUptime for capture pacing/motion timing (not for fingerprinting). -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array><string>35F9.1</string></array>
    </dict>
  </array>
</dict>
</plist>
