<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links. MUST match the appIDs and hosts in the AASA the
	     Worker serves (services/edge/tour-host/src/index.ts) - a host listed
	     here whose AASA does not name this app is a link that opens nothing,
	     and the failure is silent. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:rendprop.com</string>
		<string>applinks:www.rendprop.com</string>
	</array>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- APNs (Push/PushManager.swift). `development` is what a locally-signed
	     build needs; Xcode rewrites it to `production` when it archives for
	     TestFlight or the App Store, which is why the file carries the
	     development value rather than the shipping one.

	     REQUIRES A ONE-TIME PORTAL STEP ON THE MAC: the App ID
	     com.rendprop.app must have the Push Notifications capability enabled
	     (Certificates, Identifiers & Profiles) and an APNs key must exist for
	     the server. Until it does, automatic signing CANNOT produce a profile
	     carrying this entitlement and the build fails at the signing step with
	     "Provisioning profile doesn't support the Push Notifications
	     capability" - that is the expected failure, not a code problem. The
	     app itself degrades honestly without a token: it never prompts, and
	     Settings shows the permission state it can actually see. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
