{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rendprop-studio",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "studio.rendprop.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
