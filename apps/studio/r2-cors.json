{
  "rules": [
    {
      "id": "Rendprop Studio signed media reads",
      "allowed": {
        "origins": ["https://studio.rendprop.com"],
        "methods": ["GET", "HEAD"],
        "headers": ["Range"]
      },
      "exposeHeaders": ["Accept-Ranges", "Content-Length", "Content-Range", "Content-Type", "ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
