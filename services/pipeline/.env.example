# Rendprop AI-enhancement pipeline — provider credentials + guards.
# Copy to .env and paste values (or set these in the render-worker / Supabase
# Edge Function secrets in prod). .env is gitignored — keys never leave your box.
# The pipeline is stdlib-only, so no install is needed to run the cost-test CLI.

# ── AI providers ──────────────────────────────────────────────────────────────
# Google Gemini 2.5 Flash Image ("Nano Banana") — virtual restage (~$0.039/img).
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# fal.ai — Flux Fill masked-inpaint declutter (~$0.04) + Seedance hero clip
# (~$0.24/5s) + Flux Kontext restage fallback. One key, three routes.
FAL_KEY=
FAL_DECLUTTER_MODEL=fal-ai/flux-pro/v1/fill
FAL_RESTAGE_FALLBACK_MODEL=fal-ai/flux-pro/kontext
FAL_HERO_MODEL=fal-ai/bytedance/seedance/v1/pro/fast/image-to-video

# Anthropic — QC drift judge + room understanding. Haiku default, Sonnet escalate.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_QC=claude-haiku-4-5
ANTHROPIC_MODEL_ESCALATE=claude-sonnet-5

# Optional one-key multi-model fallback (Nano Banana / Seedance / Kling via KIE).
KIE_API_KEY=

# Which restage route is primary: gemini (cheapest) | fal (Kontext) | kie.
RESTAGE_ROUTE=gemini

# ── Supabase (cost ledger; service role — SERVER SIDE ONLY, never in the app) ──
# Leave blank to run the pipeline / cost-test locally with no DB writes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cost + quality guards ─────────────────────────────────────────────────────
QC_PASS_SCORE=85                  # min structural-consistency score to ship an edit
QC_MAX_RETRIES=2                  # regens below the bar before falling back to original
QC_CONFIDENCE_ESCALATE=0.75       # Haiku confidence below this → escalate to Sonnet
MAX_GEN_COST_PER_JOB_CENTS=2500   # hard per-job cap ($25); checked BEFORE every call

# ── Tunables (usually leave default) ──────────────────────────────────────────
FAL_POLL_INTERVAL_S=3
FAL_TIMEOUT_S=600
ANTHROPIC_VERSION=2023-06-01
