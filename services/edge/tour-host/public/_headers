# Security headers for the static marketing site (Workers Static Assets).
# The dynamic pages (/f/*, /a/*, /terms, /privacy) set their own headers in the
# Worker (src/index.ts htmlResponse).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' data:; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'; object-src 'none'

/assets/*
  Cache-Control: public, max-age=604800, immutable
