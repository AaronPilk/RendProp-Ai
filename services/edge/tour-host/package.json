{
  "name": "rendprop-tour-host",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker serving Rendprop public tour (/f/:slug), MLS-unbranded tour (/u/:slug) and portfolio (/a/:handle) pages.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-unbranded.mjs && node scripts/check-routes.mjs",
    "tail": "wrangler tail",
    "check:unbranded": "node scripts/check-unbranded.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "predeploy": "npm run typecheck && npm test && npm run check:assets"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250712.0",
    "typescript": "^5.6.3",
    "wrangler": "4.26.0"
  }
}
