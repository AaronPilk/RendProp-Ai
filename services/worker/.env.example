# Rendprop render worker — env. Copy to .env for local runs; in prod set these as
# container/Modal/Cloud Run secrets. .env is gitignored — keys never leave your box.
# The worker loads THIS file into the process env before importing the AI pipeline,
# so the provider keys below are visible to services/pipeline too (one .env, both).

# ── Supabase (service role — SERVER SIDE ONLY, never in the app) ───────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The Postgres schema the Rendprop tables live in. The dedicated project uses
# `public` (matches the edge functions + migrations). Leave as-is.
SUPABASE_DB_SCHEMA=public

# ── Cloudflare R2 (S3 API) ────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_UPLOADS=rendprop-uploads
R2_BUCKET_RENDERS=rendprop-renders
# R2_ENDPOINT=                       # optional; derived from account id if blank
# R2_PRESIGN_EXPIRY_S=3600           # lifetime of the GET url handed to Stream
# R2_CONNECT_TIMEOUT_S=10            # explicit connect timeout (external audit finding 4)
# R2_READ_TIMEOUT_S=60               # explicit read timeout — was undeclared/unbounded before

# ── Cloudflare Stream (optional — omit to serve the R2 mp4 directly) ───────────
CLOUDFLARE_STREAM_TOKEN=
# STREAM_REQUIRE_READY=0             # 1 = block until transcode ready before publish
# STREAM_POLL_INTERVAL_S=4
# STREAM_TIMEOUT_S=900

# ── AI providers (used by services/pipeline for declutter/restage/hero + QC) ───
# Only needed if jobs request enhancements. Missing keys → base tour still ships.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
FAL_KEY=
FAL_DECLUTTER_MODEL=fal-ai/flux-pro/v1/fill
FAL_RESTAGE_FALLBACK_MODEL=fal-ai/flux-pro/kontext
FAL_HERO_MODEL=fal-ai/bytedance/seedance/v1/pro/fast/image-to-video
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_QC=claude-haiku-4-5
ANTHROPIC_MODEL_ESCALATE=claude-sonnet-5
KIE_API_KEY=
RESTAGE_ROUTE=gemini

# ── Cost + quality guards (shared with the pipeline) ──────────────────────────
QC_PASS_SCORE=85
QC_MAX_RETRIES=2
QC_CONFIDENCE_ESCALATE=0.75
MAX_GEN_COST_PER_JOB_CENTS=2500

# ── ffmpeg limits (audit F-G-04 / F-G-18; expanded by the external release
#    audit, finding 4) ─────────────────────────────────────────────────────
# FFMPEG_TIMEOUT_S=5400              # TOTAL wall clock for one encode (90 min)
# FFMPEG_STALL_TIMEOUT_S=300         # kill after this long with NO progress output.
#                                    #   A value <= 0 no longer disables stall
#                                    #   detection — it now means "use the
#                                    #   default" (logged). Set
#                                    #   FFMPEG_STALL_DISABLED=1 to actually
#                                    #   turn it off.
# FFMPEG_STALL_DISABLED=0            # 1 = really disable stall detection (rare;
#                                    #   a wedged ffmpeg then runs the full
#                                    #   FFMPEG_TIMEOUT_S before anything notices)
# FFPROBE_TIMEOUT_S=60
# FFMPEG_POSTER_TIMEOUT_S=120
# MAX_SOURCE_SECONDS=7200            # matches what /uploads + create_render_job accept
# MAX_SOURCE_PIXELS=67108864         # 8192x8192 (~67 MP); refused before ffmpeg
#                                    #   decodes a single frame (real 8K is 33.2 MP)
# MAX_OUTPUT_MB=8192                 # hard cap on the ENCODED file, checked after
#                                    #   the render (the disk preflight below is
#                                    #   only an estimate, not this cap)
# MIN_FREE_DISK_FACTOR=2.5           # refuse a job unless free space > source x this

# ── ffmpeg encode knobs (mirror RenderEngine; usually leave default) ──────────
# ENCODE_LONG_EDGE=1280
# ENCODE_FPS=60
# ENCODE_BITRATE=14M
# ENCODE_PRESET=medium
# TONEMAP_HDR=1                      # tone-map PQ/HLG sources to SDR (auto-detected per source; needs zscale/tonemap)
# HERO_SECONDS=5

# ── Infra cost meters (cents) ─────────────────────────────────────────────────
# RENDER_COMPUTE_CENTS_PER_MIN=0.5   # server encode compute estimate — set from real bills
# RENDER_COMPUTE_PROVIDER=modal
# STREAM_STORE_CENTS_PER_MIN=0.5     # Cloudflare Stream storage $0.005/min

# ── Job lease / stuck-job recovery (audit F-G-05; needs migration 0015) ───────
# The worker refreshes lease_expires_at while it holds a job; an expired lease is
# reclaimed by another worker, and a job that burns WORKER_MAX_ATTEMPTS is failed
# as 'poison' so it stops consuming the org's 3-in-flight cap. Without migration
# 0014 these are inert and the worker says so at startup.
# WORKER_LEASE_S=600                 # lease length; keep > a typical encode step
# WORKER_HEARTBEAT_S=60              # refresh interval (clamped to LEASE/3)
# WORKER_MAX_ATTEMPTS=3              # claims before a job is declared poison
# REAP_INTERVAL_S=120                # how often the poller runs the reaper
# WORKER_ID=                         # default: <hostname>:<pid>

# ── Cost-ledger durability (audit F-G-07; hardened by the external release
#    audit, finding 6) ──────────────────────────────────────────────────────
# Where cost rows go when Supabase is unreachable. They are retried on the next
# flush and only removed once the DB accepts them (or the DB reports the exact
# same idempotency_key as already recorded — see migration
# 0025_cost_ledger_idempotency.sql — which is treated as success, not failure).
# The DEFAULT is now /var/lib/rendprop/ (below) rather than the system temp
# dir; if THAT path isn't writable on this host it falls back to the temp dir
# (tmpfs on Cloud Run / Modal — LOST on restart) and logs a warning once. Point
# COST_LEDGER_SPOOL at a real persistent volume if /var/lib/rendprop isn't one.
# COST_LEDGER_SPOOL=/var/lib/rendprop/cost-ledger-spool.jsonl
# COST_LEDGER_SPOOL_DURABLE=1        # assert the path above IS on a real volume
# COST_LEDGER_SPOOL_MAX_ROWS=5000
# Append/flush both take an exclusive fcntl.flock on a `.lock` sibling of the
# spool file for their whole critical section, so a flush's read-then-rewrite
# can no longer silently drop a row appended in the gap. That lock only
# coordinates within one host's view of one file — it cannot stop two SEPARATE
# hosts from each retrying "the same" spooled row, which is what the
# idempotency key (above) is actually for.

# ── Worker loop ───────────────────────────────────────────────────────────────
# POLL_INTERVAL_S=5
# RUN_ONCE=0                         # 1 = process one job then exit (serverless/cron)
# WORKER_WORKDIR=/tmp/rendprop-worker
# PIPELINE_DIR=                      # default: ../pipeline relative to this file
